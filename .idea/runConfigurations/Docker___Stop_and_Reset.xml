<component name="ProjectRunConfigurationManager">
  <configuration default="false"
                 name="Docker — Stop + Reset DB (wipe volumes)"
                 type="ShConfigurationType"
                 factoryName="Shell Script">
    <!-- Stops all containers AND deletes all volumes.
         Postgres schema will be re-applied fresh on next startup.
         Use this after schema changes or to get a clean-slate environment. -->
    <option name="SCRIPT_TEXT" value="docker compose -f .docker/docker-compose.yml --profile core --profile observability down -v" />
    <option name="INDEPENDENT_SCRIPT_PATH" value="true" />
    <option name="SCRIPT_PATH" value="" />
    <option name="SCRIPT_OPTIONS" value="" />
    <option name="INDEPENDENT_SCRIPT_WORKING_DIRECTORY" value="true" />
    <option name="SCRIPT_WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <option name="INDEPENDENT_INTERPRETER_PATH" value="true" />
    <option name="INTERPRETER_PATH" value="/bin/sh" />
    <option name="INTERPRETER_OPTIONS" value="" />
    <option name="EXECUTE_IN_TERMINAL" value="true" />
    <option name="EXECUTE_SCRIPT_FILE" value="false" />
  </configuration>
</component>
